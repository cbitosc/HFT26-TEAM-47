# Environment overrides (all optional)
NASA_TAP_URL=https://exoplanetarchive.ipac.caltech.edu/TAP/sync
CACHE_FILE=data/planets_cache.json
CACHE_MAX_AGE_HOURS=24
NEARBY_LIMIT=40
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Virtual Astronomer (Featherless AI). Copy this file to .env and add your key; .env is git-ignored.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=Qwen/Qwen2.5-14B-Instruct
FEATHERLESS_TIMEOUT_SECONDS=60
FEATHERLESS_MAX_TOKENS=1000
FEATHERLESS_TEMPERATURE=0.4
